diff --git a/metadata/04_process_model.yml b/metadata/04_process_model.yml
new file mode 100644
index 0000000..411c331
--- /dev/null
+++ b/metadata/04_process_model.yml
@@ -0,0 +1,174 @@
+# Phase 4 artifact: Manufacturing process model with standard durations
+#
+# This file defines the 12-phase Plan-to-Deliver process, baseline durations,
+# and the variance attribution rule that makes "why did OTD drop" computable.
+#
+# CRITICAL: standard_duration_days values must match dim_process_phase in
+# sql/02_staging_model.sql EXACTLY. A test compares them row by row.
+#
+# Phases 1-11 sum to 12 days (the delivery promise horizon).
+# All 12 phases sum to 13 days (billing follows delivery, cannot consume slack).
+
+phases:
+  - phase_seq: 1
+    phase_key: demand_capture
+    phase_name: Demand & order capture
+    sap_module: SAP SD
+    business_event: Sales order created
+    timestamp_field: order_date
+    standard_duration_days: 0
+    description: >
+      Customer order is received and entered into SAP SD. Zero-day event:
+      no production work occurs during this phase.
+
+  - phase_seq: 2
+    phase_key: mrp_planning
+    phase_name: Requirements planning
+    sap_module: SAP PP (MRP)
+    business_event: Planned order created
+    timestamp_field: mrp_date
+    standard_duration_days: 1
+    description: >
+      MRP run evaluates demand and creates planned orders to fulfill it.
+      Standard: 1 day from order entry to MRP execution.
+
+  - phase_seq: 3
+    phase_key: production_release
+    phase_name: Production order release
+    sap_module: SAP PP
+    business_event: Production order released
+    timestamp_field: prod_release_date
+    standard_duration_days: 1
+    description: >
+      Planned order is converted to a production order and released for execution.
+      Standard: 1 day from MRP to release.
+
+  - phase_seq: 4
+    phase_key: material_staging
+    phase_name: Material staging & issue
+    sap_module: SAP MM
+    business_event: Goods issue to production order
+    timestamp_field: material_issue_date
+    standard_duration_days: 1
+    description: >
+      Raw materials and components are staged and issued to the production order.
+      Standard: 1 day from release to material availability.
+
+  - phase_seq: 5
+    phase_key: production_execution
+    phase_name: Production execution
+    sap_module: SAP PP
+    business_event: Operation confirmed
+    timestamp_field: prod_confirm_date
+    standard_duration_days: 3
+    description: >
+      Manufacturing operations are executed and confirmed. Standard: 3 days
+      from material issue to production completion. Longest phase in the chain.
+
+  - phase_seq: 6
+    phase_key: quality_inspection
+    phase_name: Quality inspection
+    sap_module: SAP QM
+    business_event: Usage decision
+    timestamp_field: qm_final_decision_date
+    standard_duration_days: 1
+    description: >
+      Finished goods are inspected and a usage decision is recorded (accept,
+      reject, or rework). Standard: 1 day from production confirmation to
+      QM decision. For reworked lots, this is the FINAL decision date.
+
+  - phase_seq: 7
+    phase_key: goods_receipt
+    phase_name: Goods receipt to stock
+    sap_module: SAP MM / EWM
+    business_event: GR posted to unrestricted stock
+    timestamp_field: gr_date
+    standard_duration_days: 1
+    description: >
+      Accepted finished goods are posted to unrestricted-use inventory.
+      Standard: 1 day from QM decision to GR.
+
+  - phase_seq: 8
+    phase_key: picking_packing
+    phase_name: Picking & packing
+    sap_module: SAP EWM
+    business_event: Picking completed
+    timestamp_field: picking_date
+    standard_duration_days: 1
+    description: >
+      Order is picked from warehouse stock and packed for shipment.
+      Standard: 1 day from GR to picking complete.
+
+  - phase_seq: 9
+    phase_key: goods_issue
+    phase_name: Goods issue / dispatch
+    sap_module: SAP LE-SHP
+    business_event: Actual goods issue
+    timestamp_field: goods_issue_date
+    standard_duration_days: 0
+    description: >
+      Packed shipment is handed over to carrier and goods issue is posted.
+      Zero-day event: goods issue and picking occur in rapid succession.
+
+  - phase_seq: 10
+    phase_key: transportation
+    phase_name: Transportation
+    sap_module: SAP TM
+    business_event: Shipment dispatched
+    timestamp_field: shipment_date
+    standard_duration_days: 3
+    description: >
+      Carrier transports goods from warehouse to customer site. Standard: 3 days
+      from goods issue to delivery confirmation. This variance absorbs both
+      transportation and delivery_confirmation (phase 11, a zero-day POD event).
+
+  - phase_seq: 11
+    phase_key: delivery_confirmation
+    phase_name: Delivery confirmation
+    sap_module: SAP TM / LE
+    business_event: POD / delivery confirmed
+    timestamp_field: final_delivery_date
+    standard_duration_days: 0
+    description: >
+      Proof of delivery is received and the delivery is confirmed complete.
+      Zero-day event: the moment the customer accepts the shipment.
+
+  - phase_seq: 12
+    phase_key: billing
+    phase_name: Billing
+    sap_module: SAP SD
+    business_event: Invoice created
+    timestamp_field: invoice_date
+    standard_duration_days: 1
+    description: >
+      Invoice is created and sent to the customer. Standard: 1 day after
+      delivery confirmation. Billing follows delivery and cannot consume
+      delivery promise slack, so it is excluded from available_slack_days
+      computation (phases 1-11 only sum to 12).
+
+attribution:
+  rule: variance_argmax
+  description: >
+    Delay attribution identifies which phase caused an order to be late.
+    For each phase, variance = (actual_duration - standard_duration).
+    The phase with the largest positive variance is the attributed cause.
+  formula: delay_attribution_phase = argmax(variance_days) over phases 1-11
+  tie_breaking: earliest phase wins (lowest phase_seq)
+  scope: evaluated only for orders that are eligible, delivered, and late
+  exclusions:
+    - On-time orders return NULL (no delay to attribute)
+    - Not-yet-due orders return NULL (not late, pending)
+    - Cancelled orders return NULL (never delivered)
+    - Undelivered in-transit orders return NULL (not delivered)
+  notes:
+    - Phase 12 (billing) is excluded from attribution because it occurs after
+      the promised delivery date and cannot explain a delivery delay.
+    - A phase with no variance (actual = standard) cannot be the attributed
+      cause, even if all other phases are faster than standard.
+    - A phase that did not run (e.g. production for make-to-stock orders)
+      has variance = NULL and cannot be attributed.
+
+owner: VP Supply Chain Operations
+steward: Manufacturing Excellence Team
+last_reviewed: 2026-08-01
+approval_state: approved
diff --git a/tests/test_metadata.py b/tests/test_metadata.py
new file mode 100644
index 0000000..f9311d2
--- /dev/null
+++ b/tests/test_metadata.py
@@ -0,0 +1,168 @@
+import json, yaml, pytest
+from src.semantic.constants import METADATA_DIR
+
+def _yaml(name):
+    with open(METADATA_DIR / name, encoding="utf-8") as f:
+        return yaml.safe_load(f)
+
+def _json(name):
+    with open(METADATA_DIR / name, encoding="utf-8") as f:
+        return json.load(f)
+
+ARTIFACTS = [
+    "00_kpi_contract.md", "01_technical_metadata.json", "02_standardized_metadata.json",
+    "03_glossary.yml", "03_column_bindings.yml", "04_process_model.yml",
+]
+
+@pytest.mark.parametrize("name", ARTIFACTS)
+def test_artifact_exists_and_is_nonempty(name):
+    p = METADATA_DIR / name
+    assert p.exists(), f"missing {name}"
+    assert len(p.read_text(encoding="utf-8").strip()) > 200
+
+@pytest.mark.parametrize("name", ARTIFACTS)
+def test_no_placeholders(name):
+    text = (METADATA_DIR / name).read_text(encoding="utf-8")
+    for bad in ("TBD", "TODO", "FIXME", "XXX", "<placeholder>"):
+        assert bad not in text, f"{name} contains {bad}"
+
+def test_process_model_has_12_phases():
+    phases = _yaml("04_process_model.yml")["phases"]
+    assert len(phases) == 12
+    assert [p["phase_seq"] for p in phases] == list(range(1, 13))
+
+def test_process_model_durations_match_the_warehouse():
+    """The YAML and dim_process_phase must not drift apart.
+
+    Phases 1-11 sum to 12, which is exactly what available_slack_days subtracts.
+    All 12 phases sum to 13: billing follows delivery, so it cannot consume slack
+    against the promised delivery date.
+    """
+    phases = _yaml("04_process_model.yml")["phases"]
+    to_delivery = sum(
+        p["standard_duration_days"] for p in phases if p["phase_seq"] <= 11
+    )
+    assert to_delivery == 12
+    assert sum(p["standard_duration_days"] for p in phases) == 13
+
+def test_process_model_agrees_with_dim_process_phase():
+    """Same durations, same phase_keys, same order as the built warehouse."""
+    import duckdb
+    from src import build_warehouse
+    from src.semantic.constants import DB_PATH
+    build_warehouse.build()
+    con = duckdb.connect(str(DB_PATH), read_only=True)
+    try:
+        rows = con.execute("""
+            SELECT phase_seq, phase_key, standard_duration_days
+            FROM dim_process_phase ORDER BY phase_seq
+        """).fetchall()
+    finally:
+        con.close()
+    phases = sorted(_yaml("04_process_model.yml")["phases"], key=lambda p: p["phase_seq"])
+    assert [(p["phase_seq"], p["phase_key"], p["standard_duration_days"])
+            for p in phases] == rows
+
+def test_process_model_covers_manufacturing_modules():
+    phases = _yaml("04_process_model.yml")["phases"]
+    modules = {p["sap_module"] for p in phases}
+    for required in ("SAP PP", "SAP QM", "SAP MM"):
+        assert any(required in m for m in modules), f"no phase from {required}"
+
+def test_glossary_has_synonyms_for_nl_resolution():
+    """Without synonyms the resolver cannot map user vocabulary to columns."""
+    terms = {t["term"]: t for t in _yaml("03_glossary.yml")["terms"]}
+    assert "On-Time Delivery %" in terms
+    otd = terms["On-Time Delivery %"]
+    assert {"otd", "on time delivery", "delivery performance"} <= {
+        s.lower() for s in otd["synonyms"]
+    }
+    region = terms["Region"]
+    assert "india" in {v.lower() for v in region["allowed_values"]} or \
+           "IN" in region["allowed_values"]
+
+def test_every_glossary_term_has_owner_and_steward():
+    for t in _yaml("03_glossary.yml")["terms"]:
+        assert t.get("owner"), f"{t['term']} has no owner"
+        assert t.get("steward"), f"{t['term']} has no steward"
+
+def test_bindings_reference_real_fact_columns():
+    import duckdb
+    from src import build_warehouse
+    from src.semantic.constants import DB_PATH
+    build_warehouse.build()
+    con = duckdb.connect(str(DB_PATH), read_only=True)
+    for b in _yaml("03_column_bindings.yml")["bindings"]:
+        cols = {r[1] for r in con.execute(f"PRAGMA table_info('{b['table']}')").fetchall()}
+        assert b["column"] in cols, f"{b['table']}.{b['column']} does not exist"
+    con.close()
+
+def test_technical_metadata_has_sap_field_names():
+    tech = _json("01_technical_metadata.json")
+    blob = json.dumps(tech)
+    for field in ("VBELN", "KUNNR", "WADAT_IST", "AUFNR"):
+        assert field in blob, f"{field} missing from technical metadata"
+
+
+# --- Added during review of Task 4 -----------------------------------------
+# The artifacts passed every original test while carrying three defects that would
+# have surfaced as confidently wrong NL answers rather than as errors.
+
+def test_no_synonym_is_ambiguous():
+    """One phrase must not resolve to two different terms.
+
+    'PO' was a synonym of both Sales Order and Production Order, and 'location' of
+    both Region and Plant. A resolver matching user vocabulary against these lists
+    would silently pick one -- answering a production question with sales data and
+    reporting it as grounded.
+    """
+    from collections import defaultdict
+    owners = defaultdict(set)
+    for t in _yaml("03_glossary.yml")["terms"]:
+        for s in t.get("synonyms") or []:
+            owners[s.lower().strip()].add(t["term"])
+    clashes = {s: sorted(v) for s, v in owners.items() if len(v) > 1}
+    assert clashes == {}, f"ambiguous synonyms: {clashes}"
+
+def test_no_synonym_names_a_different_sap_document():
+    """A synonym must not rename the business object.
+
+    'purchase order' and 'PO' were listed under Sales Order. In SAP a purchase order
+    is a procurement document (EKKO/EKPO); a sales order is VBAK. Treating them as
+    synonyms invites a procurement question to be answered from sales data.
+    """
+    for t in _yaml("03_glossary.yml")["terms"]:
+        syns = {s.lower() for s in (t.get("synonyms") or [])}
+        if t["term"] == "Sales Order":
+            assert "purchase order" not in syns
+            assert "po" not in syns
+
+def test_every_business_binding_has_a_glossary_term():
+    """Bindings are the resolver's map from vocabulary to columns.
+
+    A business-scoped binding whose term no glossary entry defines is unreachable:
+    nothing tells the resolver what words lead to it. Internal bindings are exempt
+    by design -- they are columns the compiler reads, not things users name.
+    """
+    terms = {t["term"] for t in _yaml("03_glossary.yml")["terms"]}
+    bindings = _yaml("03_column_bindings.yml")["bindings"]
+    assert bindings, "no bindings found"
+    unscoped = [b["term"] for b in bindings if not b.get("scope")]
+    assert unscoped == [], f"bindings missing a scope: {unscoped}"
+    assert {b["scope"] for b in bindings} <= {"business", "internal"}
+    orphans = sorted(
+        b["term"] for b in bindings
+        if b["scope"] == "business" and b["term"] not in terms
+    )
+    assert orphans == [], f"business bindings with no glossary term: {orphans}"
+
+def test_metric_terms_are_defined_even_though_unbound():
+    """Metrics are computed, so they have no single column -- but must still be defined.
+
+    Guards the opposite failure from the test above: a metric dropping out of the
+    glossary because it has no binding to anchor it.
+    """
+    terms = {t["term"] for t in _yaml("03_glossary.yml")["terms"]}
+    for metric in ("On-Time Delivery %", "Manufacturing Schedule Adherence %",
+                   "First Pass Yield %", "Eligible Orders"):
+        assert metric in terms, f"{metric} missing from the glossary"
