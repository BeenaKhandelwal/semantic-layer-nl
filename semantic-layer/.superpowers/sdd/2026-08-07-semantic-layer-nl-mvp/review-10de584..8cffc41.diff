+  "steward": "Data Architecture Lead",
+  "last_reviewed": "2026-08-01",
+  "approval_state": "approved",
+  "version": "1.0",
+
+  "grain_declarations": [
+    {
+      "table": "fact_order_delivery",
+      "grain": "order",
+      "primary_key": "order_id",
+      "description": "One row per customer sales order. All delivery legs collapsed to the order grain via max(delivery_date). This is the grain for on-time delivery measurement.",
+      "enforcement": "Test test_fact_is_one_row_per_order asserts count(*) = count(DISTINCT order_id). Any fan-out from split deliveries or joins would violate this and fail the test.",
+      "why_this_grain_matters": "6 orders ship in two legs (deliveries_raw has 2 rows for SO-1009, SO-1012, SO-1014, SO-1016, SO-1017, SO-1018). Measuring OTD at delivery-leg grain double-counts split shipments and produces 88.52% instead of 87.27%. The semantic model declares grain: order and the validator rejects delivery-grain queries.",
+      "row_count": 132,
+      "unique_keys": 132
+    },
+    {
+      "table": "fact_production_order",
+      "grain": "production_order",
+      "primary_key": "production_order_id",
+      "description": "One row per production order. Used for manufacturing schedule adherence and first-pass yield metrics.",
